{#- Admin: publishing and networks. Variables: periods, days, publications, error_chart, hour_attempts, channels, broken_channels, platforms_enabled, platforms_off, storage, ai, bytes. -#}
{% extends 'layouts/admin.twig' %}
{% import 'components/display.twig' as d %}
{% import 'components/forms.twig' as f %}
{% import 'components/admin.twig' as a %}
{% set nav_current = 'stats' %}
{% set names = {telegram: 'Telegram', vk: 'ВКонтакте', max: 'MAX', instagram: 'Instagram', fake: 'Тестовая сеть'} %}
{% block title %}Публикации и сети · Админка{% endblock %}
{% block head %}{% if error_chart %}<script src="{{ asset('vendor/chart.umd.min.js') }}" nonce="{{ csp_nonce() }}" defer></script><script src="{{ asset('js/admin-charts.js') }}" nonce="{{ csp_nonce() }}" defer></script>{% endif %}{% endblock %}
{% block content %}
{{ d.page_header('Публикации и сети', 'Как идёт публикация, где ошибки и не падает ли какая-то сеть.') }}
<form class="mb-6 flex flex-wrap items-end gap-3" method="get" action="/admin/stats" aria-label="Период">
    <div class="min-w-[10rem]">{{ f.select('days', 'Период', periods, value = days) }}</div>
    {{ f.button('Показать', type = 'submit', variant = 'secondary', icon = 'filter') }}
</form>

{% set total = publications.total %}
<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {{ a.kpi('Публикаций', total.total) }}
    {{ a.kpi('Вышло', total.sent) }}
    {{ a.kpi('Не вышло', total.failed + total.unknown, hint = 'Из них неизвестно: ' ~ total.unknown, good_up = false) }}
    {{ a.kpi('Успешность', total.success is null ? '—' : total.success|number_format(1, ',', ' ') ~ '%', hint = 'Ждут своего времени: ' ~ total.waiting) }}
</div>

<section class="mt-8" aria-labelledby="plat-h"><h2 class="mb-3 text-lg font-semibold" id="plat-h">По сетям</h2>
    <div class="card !p-0 overflow-hidden">
    {% set rows %}{% for name, row in publications.platforms %}{% set lat = publications.latency[name] ?? null %}<tr>
        <td class="font-medium">{{ names[name] ?? name }}{% if name in platforms_off %} {{ d.badge('выключена', 'warn') }}{% endif %}</td>
        <td class="tabular-nums">{{ row.total }}</td><td class="tabular-nums">{{ row.sent }}</td><td class="tabular-nums">{{ row.failed + row.unknown }}</td>
        <td class="tabular-nums">{{ row.success is null ? '—' : row.success|number_format(1, ',', ' ') ~ '%' }}</td>
        <td class="tabular-nums">{{ lat ? lat.p50|number_format(1, ',', ' ') ~ ' с' : '—' }}</td>
        <td class="tabular-nums">{{ lat ? lat.p95|number_format(1, ',', ' ') ~ ' с' : '—' }}</td>
    </tr>{% endfor %}{% endset %}
    {{ d.table([{label: 'Сеть'}, {label: 'Всего'}, {label: 'Вышло'}, {label: 'Не вышло'}, {label: 'Успешность'}, {label: 'Задержка p50'}, {label: 'Задержка p95'}], empty = publications.platforms is empty, empty_title = 'Публикаций за период не было', empty_text = 'Выберите другой период.', caption = 'Публикации по сетям', body = rows) }}
    </div>
    {% if publications.latency.all is defined %}<p class="mt-2 text-sm text-muted">Задержка — разница между запланированным временем и фактической отправкой. Всего по сервису: p50 {{ publications.latency.all.p50|number_format(1, ',', ' ') }} с, p95 {{ publications.latency.all.p95|number_format(1, ',', ' ') }} с (по {{ publications.latency.all.count }} публикациям).</p>{% endif %}
</section>

{% if error_chart %}<section class="mt-8">{{ a.chart('chart-errors', error_chart.title, error_chart) }}<p class="mt-2 text-sm text-muted">Если линия сети резко пошла вверх, у неё, скорее всего, сбой. Показаны попытки отправки за последние 48 часов.</p></section>{% endif %}

<div class="mt-8 grid gap-4 lg:grid-cols-2">
    <section class="card !p-0 overflow-hidden" aria-labelledby="err-h"><h2 class="px-5 pt-5 text-lg font-semibold" id="err-h">Ошибки по видам</h2>
    {% set rows %}{% for code, byPlatform in publications.errors %}<tr><td class="font-medium">{{ {rate_limited: 'Лимит запросов сети', auth: 'Потерян доступ к каналу', permanent: 'Сеть отклонила пост', temporary: 'Сбой сети', unknown_outcome: 'Неизвестный исход', unknown: 'Без кода'}[code] ?? code }}<span class="block text-xs text-muted">{{ code }}</span></td><td class="text-sm text-muted">{% for p, n in byPlatform %}{{ names[p] ?? p }}: {{ n }}{{ not loop.last ? ' · ' : '' }}{% endfor %}</td><td class="tabular-nums">{{ byPlatform|reduce((s, n) => s + n, 0) }}</td></tr>{% endfor %}{% endset %}
    {{ d.table([{label: 'Вид ошибки'}, {label: 'По сетям'}, {label: 'Всего'}], empty = publications.errors is empty, empty_title = 'Ошибок нет', empty_text = 'За период ни одна публикация не сорвалась.', caption = 'Ошибки по видам', body = rows) }}
    </section>
    <section class="card !p-0 overflow-hidden" aria-labelledby="state-h"><h2 class="px-5 pt-5 text-lg font-semibold" id="state-h">Подключения каналов</h2>
    {% set rows %}{% for name, states in channels %}<tr><td class="font-medium">{{ names[name] ?? name }}</td><td class="text-sm text-muted">{% for s, n in states %}{{ {active: 'работают', paused: 'на паузе', error: 'с ошибкой', revoked: 'отозваны'}[s] ?? s }}: {{ n }}{{ not loop.last ? ' · ' : '' }}{% endfor %}</td></tr>{% endfor %}{% endset %}
    {{ d.table([{label: 'Сеть'}, {label: 'Состояние'}], empty = channels is empty, empty_title = 'Каналов нет', empty_text = 'Подключённые каналы появятся здесь.', caption = 'Подключения', body = rows) }}
    <p class="px-5 pb-4 text-sm text-muted">Включены в сервисе: {{ platforms_enabled|map(p => names[p] ?? p)|join(', ') ?: '—' }}. {% if platforms_off %}Выключены вручную: {{ platforms_off|map(p => names[p] ?? p)|join(', ') }}. {% endif %}<a class="underline underline-offset-2" href="/admin/platforms">Переключатели сетей</a></p>
    </section>
</div>

<div class="mt-8 grid gap-4 lg:grid-cols-2">
    <section class="card !p-0 overflow-hidden" aria-labelledby="tc-h"><h2 class="px-5 pt-5 text-lg font-semibold" id="tc-h">Каналы с самым большим числом ошибок</h2>
    {% set rows %}{% for c in publications.channels %}<tr><td class="font-medium">{{ c.title }}<span class="block text-xs text-muted">{{ names[c.platform] ?? c.platform }}</span></td><td><a class="hover:underline" href="/admin/workspaces/{{ c.workspace_public_id }}">{{ c.workspace }}</a></td><td class="tabular-nums">{{ c.failed }} из {{ c.total }}</td></tr>{% endfor %}{% endset %}
    {{ d.table([{label: 'Канал'}, {label: 'Пространство'}, {label: 'Ошибок'}], empty = publications.channels is empty, empty_title = 'Проблемных каналов нет', empty_text = 'Все публикации за период вышли.', caption = 'Проблемные каналы', body = rows) }}
    </section>
    <section class="card !p-0 overflow-hidden" aria-labelledby="tw-h"><h2 class="px-5 pt-5 text-lg font-semibold" id="tw-h">Пространства с самым большим числом ошибок</h2>
    {% set rows %}{% for w in publications.workspaces %}<tr><td class="font-medium"><a class="hover:underline" href="/admin/workspaces/{{ w.public_id }}">{{ w.name }}</a></td><td class="tabular-nums">{{ w.failed }} из {{ w.total }}</td></tr>{% endfor %}{% endset %}
    {{ d.table([{label: 'Пространство'}, {label: 'Ошибок'}], empty = publications.workspaces is empty, empty_title = 'Всё хорошо', empty_text = 'Пространств с ошибками нет.', caption = 'Проблемные пространства', body = rows) }}
    </section>
</div>

<div class="mt-8 grid gap-4 lg:grid-cols-2">
    <section class="card" aria-labelledby="stor-h"><h2 class="text-lg font-semibold" id="stor-h">Хранилище файлов</h2>
        <p class="mt-2 text-sm text-muted">Всего {{ bytes(storage.total_bytes) }}, файлов {{ storage.files }}.</p>
        {% if storage.top %}<ul class="mt-3 divide-y divide-line">{% for s in storage.top %}<li class="flex justify-between gap-3 py-2"><a class="hover:underline" href="/admin/workspaces/{{ s.public_id }}">{{ s.name }}</a><span class="tabular-nums text-muted">{{ bytes(s.bytes) }} · {{ s.files }}</span></li>{% endfor %}</ul>{% else %}<p class="mt-3 text-muted">Файлов пока нет.</p>{% endif %}
    </section>
    <section class="card" aria-labelledby="ai-h"><h2 class="text-lg font-semibold" id="ai-h">AI-ассистент</h2>
        {% if ai.requests > 0 %}
        <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm"><dt class="text-muted">Запросов за период</dt><dd class="tabular-nums">{{ ai.requests }}</dd><dt class="text-muted">Потрачено кредитов</dt><dd class="tabular-nums">{{ ai.credits }}</dd><dt class="text-muted">Себестоимость (счёт провайдера)</dt><dd class="tabular-nums">{{ money(ai.cost) }}</dd></dl>
        {% else %}<p class="mt-2 text-muted">Запросов пока не было. Расход кредитов, себестоимость у провайдера и маржа появятся здесь вместе с AI-ассистентом.</p>{% endif %}
    </section>
</div>
<section class="mt-8 card" aria-labelledby="source-text-h"><h2 class="text-lg font-semibold" id="source-text-h">{{ t('Обработка текста источников') }}</h2>
<p class="mt-2 text-sm text-muted">{{ t('Технические результаты обработки за выбранный период. Тексты и инструкции здесь не отображаются.') }}</p>
<dl class="mt-3 grid gap-2">{% for status, label in {processing: 'Обрабатываются', completed: 'Готово', failed: 'Ошибки', stale: 'Устаревшие попытки'} %}<div class="flex justify-between gap-3"><dt>{{ t(label) }}</dt><dd>{{ source_text[status] }}</dd></div>{% endfor %}</dl>
</section>
{% set semantic_counts %}<dl class="grid gap-2">{% for status, label in {completed: 'Оценены', failed: 'Ошибки', blocked: 'Остановлены правилами'} %}<div class="flex justify-between gap-3"><dt>{{ t(label) }}</dt><dd>{{ semantic_selection[status] }}</dd></div>{% endfor %}</dl><p class="mt-3 text-sm text-muted">{{ t('Структурированные оценки Fake provider. Содержимое материалов и критерии здесь не отображаются.') }}</p>{% endset %}
<div class="mt-5">{{ d.card(t('Смысловой отбор'), body = semantic_counts) }}</div>
{% endblock %}
