{% extends 'layouts/app.twig' %}
{% import 'components/display.twig' as d %}
{% import 'components/forms.twig' as f %}
{% set nav_current = 'sources' %}
{% set heading = source ? t('Редактировать источник') : t('Добавить источник') %}
{% block title %}{{ heading }} · {{ app_name }}{% endblock %}
{% block content %}
{{ d.breadcrumbs([{label: t('Источники'), href: base}, {label: heading}]) }}
<div class="mt-3">{{ d.page_header(heading, t('Добавьте Telegram-канал и включите источник, чтобы получать материалы.')) }}</div>
<form class="card grid max-w-xl gap-5" method="post" action="{{ source ? base ~ '/' ~ source.publicId : base }}" data-source-form>
    {{ csrf_field() }}
    {% if errors('form') %}{{ d.alert('error', t('Не удалось сохранить источник'), errors('form')|first) }}{% endif %}
    {{ f.input('name', t('Название'), value = old('name', source ? source.name : ''), error = errors('name')|first, required = true, attrs = {maxlength: 255}) }}
    {{ f.select('type', t('Тип источника'), {telegram: 'Telegram'}, value = old('type', source ? source.type.value : 'telegram'), error = errors('type')|first, required = true) }}
    {{ f.input('reference', t('Канал Telegram'), value = old('reference', source ? '@' ~ source.telegramUsername : ''), hint = t('Публичный канал: @username или https://t.me/username. Доступность канала пока не проверяется.'), error = errors('reference')|first, placeholder = '@username', required = true, attrs = {maxlength: 128, autocapitalize: 'none', spellcheck: 'false'}) }}
    {{ f.switch('enabled', t('Источник включён'), checked = old('enabled', source and source.enabled ? '1' : '0') == '1', hint = t('Включите, чтобы получать материалы из канала. Подключение выполняется автоматически.')) }}
    {% if source %}<p class="text-sm text-muted">{{ t('Статус подключения') }}: {{ t(source.status.label()) }}</p>{% endif %}
    <div class="flex flex-wrap gap-3">{{ f.button(source ? t('Сохранить источник') : t('Добавить источник'), type = 'submit') }}{{ f.button(t('Отмена'), href = source ? base ~ '/' ~ source.publicId : base, variant = 'secondary') }}</div>
</form>
<script src="{{ asset('js/sources.js') }}" nonce="{{ csp_nonce() }}" defer></script>
{% endblock %}
